FLASK_APP=services/api/app.py
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5001
# Explicit profiles: lending-devnet (dedicated endpoint), devnet, testnet.
# No automatic fallback. devnet currently has the native lending amendments.
LENDING_NETWORK=devnet
# Dedicated Lending Devnet ID must be independently verified before signing.
# Standard devnet=2 and testnet=1 are pinned in code.
LENDING_NETWORK_ID=
# Leave blank until an OFFICIAL issuer on the selected Devnet has been verified.
# Testnet profile uses Ripple's documented issuer automatically.
LENDING_RLUSD_ISSUER=
LENDING_RLUSD_ISSUER_SOURCE=
# Map product pools to real RLUSD Vault object IDs on the chosen network.
LENDING_VAULTS={}
# Dedicated network: configure only a verified matching-network explorer prefix.
# Devnet and Testnet profiles have known explorer prefixes.
LENDING_EXPLORER_TX_URL=
# Keep disabled for ledger functionality. Historic demo API records are preserved.
ENABLE_SIMULATION=false
# No wallet seeds or private keys are required by Flask or the frontend.

# Native MOCKRLUSD deployment: node scripts/native/deploy.mjs
# Flask loads ignored instance/native-devnet.json automatically on Devnet.
# Node >=20.19 is required for the local test broker signer and token faucet.
# FLOW_NODE=/absolute/path/to/node

# Optional hosted mock-company store. Keep FLOW_SUPABASE_API_KEY server-side only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
FLOW_SUPABASE_API_KEY=
